{
  "name": "graphql-boilerplate",
  "version": "1.0.0",
  "description": "GraphQL API boilerplate with Apollo Server, Express, MongoDB, Redis and Firebase Auth",
  "main": "build/index.js",
  "scripts": {
    "start": "pnpm with-env node build/index.js",
    "prod": "pnpm migrate:up && pnpm start",
    "dev": "pnpm with-env nodemon src/index.ts",
    "build": "swc src -d build --copy-files --strip-leading-paths --delete-dir-on-start",
    "test": "pnpm with-env c8 ava src/core/ src/lib",
    "test:watch": "pnpm with-env c8 ava --watch src/core/ src/lib",
    "lint": "eslint --max-warnings=0 --ext .ts .",
    "lint:fix": "eslint --max-warnings=0 --fix --ext .ts .",
    "migrate:up": "pnpm with-env migrate-mongo up",
    "migrate:down": "pnpm with-env migrate-mongo down",
    "generate": "graphql-codegen",
    "ts:check": "tsc --noEmit",
    "with-env": "env-cmd --no-override --silent --fallback -f ./config/.env --",
    "knip": "knip"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "1.1.2",
    "@google-cloud/pubsub": "^5.0.0",
    "@graphql-codegen/typescript-mongodb": "^4.0.2",
    "@graphql-tools/load-files": "7.0.1",
    "@graphql-tools/merge": "9.1.1",
    "@graphql-tools/schema": "10.0.25",
    "@graphql-tools/utils": "10.9.1",
    "axios": "^1.19.0",
    "body-parser": "^1.20.6",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "env-cmd": "11.0.0",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "10.2.1",
    "graphql": "16.11.0",
    "graphql-middleware": "6.1.35",
    "jsonwebtoken": "9.0.2",
    "migrate-mongo": "12.1.3",
    "mongodb": "6.18.0",
    "mongoose": "^8.24.3",
    "redis": "5.6.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "validator": "^13.15.35",
    "winston": "3.17.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "9.2.1",
    "@faker-js/faker": "9.9.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@swc-node/register": "1.10.10",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.13.5",
    "@types/express": "4.17.23",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "20.14.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "ava": "5.3.1",
    "c8": "10.1.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-helpers": "1.3.1",
    "eslint-plugin-prettier": "5.5.6",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "sinon": "^22.1.0",
    "supertest": "7.1.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": ">=11.1.1",
      "@opentelemetry/core@<2.8.0": ">=2.8.0"
    }
  }
}
