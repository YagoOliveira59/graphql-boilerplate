# ============================================================
# GraphQL Boilerplate — Environment Variables
# Copy this file to config/.env and fill in the values
# ============================================================

# --- Server ---
# TODO: Change NODE_ENV to 'production' in production environments
NODE_ENV=development
PORT=4000

# --- GraphQL Playground ---
# Set to 'false' to disable the GraphQL playground in production
GRAPHQL_PLAYGROUND=true

# --- Logging ---
# Set to 'false' to use JSON log format (recommended for production)
LOG_HUMAN=true
# LOG_LEVEL=info

# ============================================================
# Database
# ============================================================

# MongoDB connection string
# TODO: Replace with your MongoDB URI
MONGODB_URI=mongodb://localhost:27017/graphql-boilerplate

# ============================================================
# Cache
# ============================================================

# Redis connection URL
# TODO: Replace with your Redis URL
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Firebase Authentication
# ============================================================
# Used to verify Firebase ID tokens from the client.
# TODO: Create a Firebase project and fill in the values below.

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com/

# Set to 'true' to use the default service account (e.g. when running in GCP)
FIREBASE_USE_DEFAULT_SERVICE_ACCOUNT=false

# Required when FIREBASE_USE_DEFAULT_SERVICE_ACCOUNT=false
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# The private key must be a valid RSA key. Use single quotes to preserve newlines.
FIREBASE_PRIVATE_KEY='<< FIREBASE PRIVATE KEY HERE (paste the full -----BEGIN PRIVATE KEY----- block) >>'

# ============================================================
# JWT / Internal Auth
# ============================================================
# TODO: Generate a strong RS256 key pair for production.
# The TOKEN_SECRET is the private key used to sign internal JWTs.

# RS256 private key for signing internal auth tokens
APP_TOKEN_SECRET='<< RS256 PRIVATE KEY HERE >>'

# HS256 secret for inter-service tokens (worker authentication)
JWT_SECRET='<< RANDOM SECRET FOR WORKER TOKENS >>'

# ============================================================
# Google Cloud Pub/Sub (Optional — remove if not used)
# ============================================================
# TODO: Remove these variables if you are not using Pub/Sub.

EVENTS_TOPIC=events
EVENTS_PROJECT=your-gcp-project-id

# ============================================================
# Application URLs
# ============================================================
# TODO: Replace with your actual application URLs.

APP_URL=http://localhost:3000

# ============================================================
# External Services (Optional — add/remove as needed)
# ============================================================
# TODO: Add environment variables for any external APIs here.
# EXTERNAL_API_URL=https://api.example.com
# EXTERNAL_API_KEY=your-api-key
